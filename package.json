{
  "name": "docker-admin-server",
  "version": "1.0.0",
  "description": "A lightweight web-based GUI for managing and exploring Docker containers, images, and logs on a local machine, powered by Node.js and dockerode.",
  "main": "dist/index.js",
  "bin": {
    "docker-admin-server": "dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "jest",
    "test:core": "jest tests/core",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest tests/e2e",
    "test:e2e:ts": "jest tests/e2e/safe-api.test.ts",
    "test:integration": "jest tests/integration",
    "test:openapi": "jest tests/openapi",
    "test:apis": "jest tests/apis",
    "test:all": "jest tests",
    "start": "npx ts-node src/index.ts",
    "build": "tsc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dockerode": "^4.0.7",
    "express": "^5.1.0",
    "inversify": "^7.6.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^3.3.42",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.1.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-parser": "^4.0.3",
    "eslint": "^9.32.0",
    "jest": "^30.0.5",
    "js-yaml": "^4.1.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "swagger-parser": "^10.0.3",
    "ts-jest": "^29.4.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
